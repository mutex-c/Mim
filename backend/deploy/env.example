# Mim Environment Variables Configuration Example
# Copy this file to .env before starting services

# Standalone Server Port (Avoids conflicting with default 8080)
MIM_PORT=8088

# MySQL Configuration
MYSQL_ROOT_PASSWORD=mim_root_password_2026
MYSQL_DATABASE=mim_db
MYSQL_USER=mim_user
MYSQL_PASSWORD=mim_password_2026
MYSQL_PORT=3306

# Redis Configuration
REDIS_PORT=6379
REDIS_PASSWORD=mim_redis_pass_2026

# Etcd Configuration
ETCD_PORT=2379
ETCD_PEER_PORT=2380

# Kafka & Zookeeper Configuration
ZOOKEEPER_PORT=2181
KAFKA_PORT=9092
KAFKA_CFG_ZOOKEEPER_CONNECT=zookeeper:2181

# Jaeger APM Configuration
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318

# Prometheus Configuration
PROMETHEUS_PORT=9090
